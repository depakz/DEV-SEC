# Copy to terraform.tfvars and fill in your own values.
# Do NOT commit terraform.tfvars — it's already in .gitignore.

project_name        = "secscan"
location            = "East US"
environment         = "dev"
backend_image_tag   = "latest"
frontend_image_tag  = "latest"

# Secrets should come from an environment variable instead, e.g.:
#   export TF_VAR_scanner_hmac_secret="$(openssl rand -hex 32)"
# rather than being written here at all.
